---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { categories } from '../data/blog.js';
import { postsInCategory, postUrl, categoryUrl, imgUrl } from '../data/site.js';

const sections = categories
  .map((c) => {
    const inCat = postsInCategory(c.slug);
    return {
      name: c.name,
      href: categoryUrl(c.slug),
      seeAll: `See all ${inCat.length} →`,
      posts: inCat.slice(0, 4),
    };
  })
  .filter((s) => s.posts.length > 0);
---
<Base title="Browse by Category — Life with MTG">
  <Header active="categories" />

  <main class="pad-x" style="max-width:1200px; margin:0 auto; padding:56px 40px 72px;">

    <h1 class="display" style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:56px; line-height:1.04; color:#16243f; letter-spacing:-0.015em;">Browse by Category</h1>
    <p style="margin:18px 0 0; font-size:20px; line-height:1.55; color:#514c40; max-width:660px;">Everything MTG writes, sorted by what it's about. Pick a category to narrow down — or search across all of them.</p>

    <!-- filter pills -->
    <div style="display:flex; flex-wrap:wrap; gap:14px; margin-top:34px;">
      {categories.map((c) => (
        <a href={categoryUrl(c.slug)} style="font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:600; color:#16243f; background:#faf5ea; border:1px solid rgba(43,42,36,0.28); border-radius:999px; padding:11px 26px;">{c.name}</a>
      ))}
    </div>

    <!-- search -->
    <div style="display:flex; align-items:center; justify-content:space-between; gap:20px; margin-top:26px; flex-wrap:wrap;">
      <label style="display:flex; align-items:center; gap:12px; flex:1; min-width:280px; max-width:540px; background:#faf5ea; border:1px solid rgba(43,42,36,0.22); border-radius:10px; padding:14px 18px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8a8172" stroke-width="2.2"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
        <input id="cat-search" type="text" placeholder="Search all posts…" style="flex:1; background:transparent; border:none; outline:none; font-family:'Libre Franklin',sans-serif; font-size:17px; color:#33322b;">
      </label>
      <div style="display:flex; align-items:center; gap:10px; font-family:'Libre Franklin',sans-serif; font-size:16px; color:#8a8172;">
        <span>Sort:</span>
        <span style="display:inline-flex; align-items:center; gap:8px; font-weight:700; color:#16243f;">Most Recent
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16243f" stroke-width="2.5"><path d="m6 9 6 6 6-6"></path></svg>
        </span>
      </div>
    </div>

    <!-- ===== SECTIONS ===== -->
    <div id="cat-sections">
      {sections.map((sec) => (
        <section style="margin-top:42px;">
          <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; border-bottom:2px solid rgba(43,42,36,0.22); padding-bottom:12px; margin-bottom:24px;">
            <h2 style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:34px; line-height:1.05; color:#16243f;"><a href={sec.href}>{sec.name}</a></h2>
            <a href={sec.href} style="font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:700; color:#b41f2c; white-space:nowrap;">{sec.seeAll}</a>
          </div>
          <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:26px;">
            {sec.posts.map((post) => (
              <a href={postUrl(post.slug)} data-title={post.title}><article style="display:grid; grid-template-columns:92px 1fr; gap:20px; align-items:center; background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:12px; padding:16px;">
                <img src={imgUrl(post.image)} alt="" style="display:block; width:92px; height:92px; object-fit:cover; object-position:center 30%; border-radius:8px;">
                <div>
                  <h4 style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:20px; line-height:1.22; color:#16243f;">{post.title}</h4>
                  <p style="margin:10px 0 0; font-family:'Libre Franklin',sans-serif; font-size:14px; color:#8a8172;">{post.date}</p>
                </div>
              </article></a>
            ))}
          </div>
        </section>
      ))}

      <p id="cat-empty" style="display:none; margin:48px 0; text-align:center; font-family:'Newsreader',serif; font-style:italic; font-size:24px; color:#8a8172;">No posts match your search.</p>
    </div>
  </main>

  <Footer />
</Base>

<script>
  // Search across all sections; hides sections that end up empty.
  const input = document.getElementById('cat-search');
  if (input) {
    input.addEventListener('input', (e) => {
      const term = (e.currentTarget.value || '').toLowerCase().trim();
      let any = false;
      document.querySelectorAll('#cat-sections > section').forEach((sec) => {
        let visible = 0;
        sec.querySelectorAll('a[data-title]').forEach((a) => {
          const t = (a.getAttribute('data-title') || '').toLowerCase();
          const match = !term || t.indexOf(term) !== -1;
          a.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        sec.style.display = visible > 0 ? '' : 'none';
        if (visible > 0) any = true;
      });
      const empty = document.getElementById('cat-empty');
      if (empty) empty.style.display = any ? 'none' : 'block';
    });
  }
</script>
