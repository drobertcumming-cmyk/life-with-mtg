---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../data/site.js';
---
<Base title="Contact Us — Life with MTG">
  <Header active="contact" />

  <main class="pad-x" style="max-width:1200px; margin:0 auto; padding:64px 40px 72px;">

    <p style="margin:0 0 16px; font-family:'Libre Franklin',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.22em; text-transform:uppercase; color:#b41f2c;">Contact Us</p>
    <h1 class="display" style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:62px; line-height:1.02; color:#16243f; letter-spacing:-0.015em;">Get in touch</h1>
    <p style="margin:22px 0 0; font-size:20px; line-height:1.55; color:#514c40; max-width:620px;">Questions, feedback, or just want to say hello? Send a note and it'll reach the right place.</p>

    <div class="grid-contact" style="display:grid; grid-template-columns:1fr 1.35fr; gap:64px; margin-top:52px; align-items:start;">

      <!-- LEFT: address + social + press -->
      <div>
        <h2 style="margin:0 0 16px; font-family:'Libre Franklin',sans-serif; font-size:13px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#8a8172;">Mailing Address</h2>
        <p style="margin:0; font-family:'Libre Franklin',sans-serif; font-size:20px; line-height:1.55; color:#16243f;">Life with MTG<br>300 Broad Street, Suite 4<br>Rome, GA 30161 <span style="font-family:'Libre Franklin',sans-serif; font-size:16px; font-style:italic; color:#8a8172;">· placeholder</span></p>

        <h2 style="margin:44px 0 16px; font-family:'Libre Franklin',sans-serif; font-size:13px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#8a8172;">Follow</h2>
        <div style="display:flex; gap:16px;">
          <a href="#" aria-label="X" style="width:56px; height:56px; border-radius:50%; background:#16243f; display:flex; align-items:center; justify-content:center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="#f6efdf"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-6.9l-5.4-7-6.2 7H1.7l8.1-9.3L1 2h7.1l4.9 6.4L18.9 2Zm-2.4 18h1.9L7.6 4H5.6l10.9 16Z"/></svg></a>
          <a href="#" aria-label="Facebook" style="width:56px; height:56px; border-radius:50%; background:#16243f; display:flex; align-items:center; justify-content:center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="#f6efdf"><path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1C18.1 3 17.2 3 16.2 3c-2.3 0-3.9 1.4-3.9 4v2.6H9.5v3.2h2.8V21h1.2Z"/></svg></a>
          <a href="#" aria-label="Instagram" style="width:56px; height:56px; border-radius:50%; background:#16243f; display:flex; align-items:center; justify-content:center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f6efdf" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1.2" fill="#f6efdf" stroke="none"></circle></svg></a>
          <a href="#" aria-label="YouTube" style="width:56px; height:56px; border-radius:50%; background:#16243f; display:flex; align-items:center; justify-content:center;"><svg width="24" height="24" viewBox="0 0 24 24" fill="#f6efdf"><path d="M22 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.8 1.8C5.7 19 12 19 12 19s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8C22 15.2 22 12 22 12Zm-12 3V9l5 3-5 3Z"/></svg></a>
        </div>

        <div style="margin-top:40px; background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; padding:26px 28px;">
          <div style="display:flex; align-items:center; gap:12px;">
            <span style="width:18px; height:18px; border:2px solid #b41f2c; border-radius:4px; flex:none;"></span>
            <h3 style="margin:0; font-family:'Libre Franklin',sans-serif; font-size:19px; font-weight:700; color:#16243f;">Press &amp; booking</h3>
          </div>
          <p style="margin:14px 0 0; font-family:'Libre Franklin',sans-serif; font-size:17px; line-height:1.55; color:#514c40;">Interview and appearance requests are handled on the <a href={withBase('/media/')} style="color:#b41f2c; font-weight:700;">Media</a> page.</p>
        </div>
      </div>

      <!-- RIGHT: form card -->
      <div style="background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:18px; padding:44px 46px;">
        <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
          <div>
            <label style="display:block; margin:0 0 10px; font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:600; color:#33322b;">Name</label>
            <input type="text" placeholder="Your name" style="width:100%; box-sizing:border-box; font-family:'Libre Franklin',sans-serif; font-size:17px; color:#16243f; background:#ffffff; border:1px solid rgba(43,42,36,0.2); border-radius:10px; padding:16px 18px;">
          </div>
          <div>
            <label style="display:block; margin:0 0 10px; font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:600; color:#33322b;">Email</label>
            <input type="email" placeholder="you@email.com" style="width:100%; box-sizing:border-box; font-family:'Libre Franklin',sans-serif; font-size:17px; color:#16243f; background:#ffffff; border:1px solid rgba(43,42,36,0.2); border-radius:10px; padding:16px 18px;">
          </div>
        </div>

        <div style="margin-top:24px;">
          <label style="display:block; margin:0 0 10px; font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:600; color:#33322b;">Subject</label>
          <input type="text" placeholder="What's this about?" style="width:100%; box-sizing:border-box; font-family:'Libre Franklin',sans-serif; font-size:17px; color:#16243f; background:#ffffff; border:1px solid rgba(43,42,36,0.2); border-radius:10px; padding:16px 18px;">
        </div>

        <div style="margin-top:24px;">
          <label style="display:block; margin:0 0 10px; font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:600; color:#33322b;">Message</label>
          <textarea placeholder="Your message…" rows="6" style="width:100%; box-sizing:border-box; font-family:'Libre Franklin',sans-serif; font-size:17px; line-height:1.5; color:#16243f; background:#ffffff; border:1px solid rgba(43,42,36,0.2); border-radius:10px; padding:16px 18px; resize:vertical;"></textarea>
        </div>

        <div style="display:flex; align-items:center; justify-content:space-between; gap:20px; margin-top:28px; flex-wrap:wrap;">
          <button type="button" style="font-family:'Libre Franklin',sans-serif; font-size:18px; font-weight:700; color:#fdf6ea; background:#b41f2c; border:none; border-radius:10px; padding:16px 40px; cursor:pointer;">Send</button>
          <p style="margin:0; font-family:'Libre Franklin',sans-serif; font-size:15px; color:#8a8172;">Protected by <a href="#" style="color:#8a8172; text-decoration:underline;">reCAPTCHA</a> · <a href="#" style="color:#b41f2c; font-weight:600; text-decoration:underline;">Privacy</a></p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Base>
