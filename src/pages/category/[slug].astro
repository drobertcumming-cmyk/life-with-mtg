---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { categories } from '../../data/blog.js';
import { postsInCategory, categoryBySlug, postUrl, categoryUrl, imgUrl, withBase, kickerOf } from '../../data/site.js';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const cat = categoryBySlug(slug);
const inCat = postsInCategory(slug);
const featured = inCat[0];
const rest = inCat.slice(1);
---
<Base title={`${cat.name} — Life with MTG`} description={cat.description}>
  <Header active="categories" />

  <main class="pad-x" style="max-width:1200px; margin:0 auto; padding:34px 40px 72px;">

    <!-- breadcrumb -->
    <p style="margin:0 0 20px; font-family:'Libre Franklin',sans-serif; font-size:15px; color:#8a8172;">
      <a href={withBase('/')} style="color:#b41f2c; font-weight:600;">Home</a>
      <span style="margin:0 8px; color:#b0a894;">›</span>
      <a href={withBase('/categories/')} style="color:#b41f2c; font-weight:600;">Categories</a>
      <span style="margin:0 8px; color:#b0a894;">›</span>
      <span style="color:#8a8172;">{cat.name}</span>
    </p>

    <h1 class="display" style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:58px; line-height:1.02; color:#16243f; letter-spacing:-0.015em;">{cat.name}</h1>
    <p style="margin:20px 0 0; font-size:20px; line-height:1.55; color:#514c40; max-width:760px;">{cat.description}</p>

    <!-- pills -->
    <div style="display:flex; flex-wrap:wrap; gap:14px; margin-top:36px;">
      {categories.map((c) => (
        <a
          href={categoryUrl(c.slug)}
          style={c.slug === slug
            ? "font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:700; color:#fdf6ea; background:#16243f; border:1px solid #16243f; border-radius:999px; padding:11px 26px;"
            : "font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:600; color:#16243f; background:#faf5ea; border:1px solid rgba(43,42,36,0.28); border-radius:999px; padding:11px 26px;"}
        >{c.name}</a>
      ))}
    </div>

    <!-- search + sort -->
    <div style="display:flex; align-items:center; justify-content:space-between; gap:20px; margin-top:26px; padding-top:26px; border-top:1px solid rgba(43,42,36,0.16); flex-wrap:wrap;">
      <label style="display:flex; align-items:center; gap:12px; flex:1; min-width:280px; max-width:540px; background:#faf5ea; border:1px solid rgba(43,42,36,0.22); border-radius:10px; padding:14px 18px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8a8172" stroke-width="2.2"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
        <input id="cat-search" type="text" placeholder="Search this category…" style="flex:1; background:transparent; border:none; outline:none; font-family:'Libre Franklin',sans-serif; font-size:17px; color:#33322b;">
      </label>
      <div style="display:flex; align-items:center; gap:10px; font-family:'Libre Franklin',sans-serif; font-size:16px; color:#8a8172;">
        <span>Sort:</span>
        <span style="display:inline-flex; align-items:center; gap:8px; font-weight:700; color:#16243f;">Most Recent
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16243f" stroke-width="2.5"><path d="m6 9 6 6 6-6"></path></svg>
        </span>
      </div>
    </div>

    <div id="cat-posts">
      <!-- featured -->
      <a href={postUrl(featured.slug)} data-title={featured.title}><article style="display:grid; grid-template-columns:400px 1fr; background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; overflow:hidden; margin-top:30px;" class="grid-featured">
        <div style="position:relative; min-height:320px;">
          <img src={imgUrl(featured.image)} alt={featured.title} style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 30%;">
          <span style="position:absolute; top:20px; left:20px; font-family:'Libre Franklin',sans-serif; font-size:12px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#fdf6ea; background:#b41f2c; padding:7px 14px; border-radius:6px;">Featured</span>
        </div>
        <div style="padding:40px 44px; align-self:center;">
          <p style="margin:0 0 12px; font-family:'Libre Franklin',sans-serif; font-size:13px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#b41f2c;">{kickerOf(featured)}</p>
          <h3 style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:36px; line-height:1.08; color:#16243f; letter-spacing:-0.01em;">{featured.title}</h3>
          <p style="margin:20px 0 0; font-family:'Libre Franklin',sans-serif; font-size:18px; line-height:1.6; color:#514c40;">{featured.snippet}</p>
          <p style="margin:20px 0 0; font-family:'Libre Franklin',sans-serif; font-size:15px; color:#8a8172;">{featured.date} · {featured.readTime}</p>
        </div>
      </article></a>

      {rest.length > 0 && (
        <>
          <p style="margin:44px 0 22px; font-family:'Libre Franklin',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#8a8172;">More in {cat.name}</p>

          <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:28px;">
            {rest.map((post) => (
              <a href={postUrl(post.slug)} data-title={post.title}><article style="display:flex; flex-direction:column; background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; overflow:hidden; height:100%;">
                <img src={imgUrl(post.image)} alt="" style="display:block; width:100%; height:210px; object-fit:cover; object-position:center 30%;">
                <div style="padding:24px 26px 28px;">
                  <p style="margin:0 0 10px; font-family:'Libre Franklin',sans-serif; font-size:12px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#b41f2c;">{kickerOf(post)}</p>
                  <h4 style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:24px; line-height:1.18; color:#16243f;">{post.title}</h4>
                  <p style="margin:14px 0 0; font-family:'Libre Franklin',sans-serif; font-size:16px; line-height:1.55; color:#514c40;">{post.snippet}</p>
                  <p style="margin:16px 0 0; font-family:'Libre Franklin',sans-serif; font-size:14px; color:#8a8172;">{post.date} · {post.readTime}</p>
                </div>
              </article></a>
            ))}
          </div>
        </>
      )}

      <p id="cat-empty" style="display:none; margin:48px 0; text-align:center; font-family:'Newsreader',serif; font-style:italic; font-size:24px; color:#8a8172;">No posts match your search.</p>
    </div>

    <!-- newsletter band -->
    <div style="background:#16243f; border-radius:14px; padding:34px 42px; display:flex; align-items:center; justify-content:space-between; gap:28px; margin-top:40px; flex-wrap:wrap;">
      <div>
        <h3 style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:30px; color:#f6efdf;">Never miss a post</h3>
        <p style="margin:8px 0 0; font-family:'Libre Franklin',sans-serif; font-size:16px; color:#b6bfd1;">Her take, straight to your inbox.</p>
      </div>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <input type="email" placeholder="Email address" style="font-family:'Libre Franklin',sans-serif; font-size:16px; color:#16243f; background:#ffffff; border:none; border-radius:9px; padding:15px 20px; min-width:240px;">
        <button type="button" style="font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:700; color:#fdf6ea; background:#b41f2c; border:none; border-radius:9px; padding:15px 30px; cursor:pointer;">Sign Up</button>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<script>
  // Live search within this category: filters the featured + grid cards by title.
  const input = document.getElementById('cat-search');
  if (input) {
    input.addEventListener('input', (e) => {
      const term = (e.currentTarget.value || '').toLowerCase().trim();
      const cards = document.querySelectorAll('#cat-posts a[data-title]');
      let shown = 0;
      cards.forEach((a) => {
        const t = (a.getAttribute('data-title') || '').toLowerCase();
        const match = !term || t.indexOf(term) !== -1;
        a.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      const empty = document.getElementById('cat-empty');
      if (empty) empty.style.display = (term && shown === 0) ? 'block' : 'none';
    });
  }
</script>
