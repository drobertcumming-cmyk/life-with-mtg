---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sortedPosts, postUrl, imgUrl, shortCat } from '../data/site.js';

// One recent post from each of the first three distinct categories.
const sorted = sortedPosts();
const seen = new Set();
const recentPosts = [];
for (const p of sorted) {
  if (!seen.has(p.category)) { seen.add(p.category); recentPosts.push(p); }
  if (recentPosts.length === 3) break;
}
---
<Base title="Subscribe — Life with MTG">
  <Header />

  <main class="pad-x" style="max-width:1200px; margin:0 auto; padding:70px 40px 72px;">

    <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:72px; align-items:start;">
      <!-- left copy -->
      <div>
        <p style="margin:0 0 16px; font-family:'Libre Franklin',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.22em; text-transform:uppercase; color:#b41f2c;">Stay Connected</p>
        <h1 class="display" style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:62px; line-height:1.03; color:#16243f; letter-spacing:-0.015em;">Get it straight to your inbox</h1>
        <p style="margin:26px 0 0; font-size:20px; line-height:1.6; color:#514c40; max-width:540px;">Join MTG's list for new posts, her take on what's actually moving — politics, your money, your health, faith — and the occasional note you won't find anywhere else. <span style="font-style:italic; color:#8a8172;">[Final blurb is your copy.]</span></p>

        <ul style="list-style:none; margin:34px 0 0; padding:0; display:flex; flex-direction:column; gap:18px;">
          <li style="display:flex; align-items:center; gap:14px;">
            <span style="width:22px; height:22px; border:2px solid #b41f2c; border-radius:5px; flex:none; display:flex; align-items:center; justify-content:center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#b41f2c" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 6"></path></svg></span>
            <span style="font-family:'Libre Franklin',sans-serif; font-size:18px; color:#33322b;">New posts the moment they publish</span>
          </li>
          <li style="display:flex; align-items:center; gap:14px;">
            <span style="width:22px; height:22px; border:2px solid #b41f2c; border-radius:5px; flex:none; display:flex; align-items:center; justify-content:center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#b41f2c" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 6"></path></svg></span>
            <span style="font-family:'Libre Franklin',sans-serif; font-size:18px; color:#33322b;">Her voice, unfiltered — no handlers</span>
          </li>
          <li style="display:flex; align-items:center; gap:14px;">
            <span style="width:22px; height:22px; border:2px solid #b41f2c; border-radius:5px; flex:none; display:flex; align-items:center; justify-content:center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#b41f2c" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 6"></path></svg></span>
            <span style="font-family:'Libre Franklin',sans-serif; font-size:18px; color:#33322b;">No spam. Unsubscribe anytime.</span>
          </li>
        </ul>
      </div>

      <!-- right form card -->
      <div style="background:#16243f; border-radius:18px; padding:44px 44px 40px;">
        <h2 style="margin:0 0 28px; font-family:'Newsreader',serif; font-weight:600; font-size:34px; color:#f6efdf;">Sign up free</h2>
        <input type="text" placeholder="First Name" style="width:100%; box-sizing:border-box; font-family:'Libre Franklin',sans-serif; font-size:17px; color:#16243f; background:#ffffff; border:none; border-radius:10px; padding:18px 22px; margin-bottom:16px;">
        <input type="email" placeholder="Email address" style="width:100%; box-sizing:border-box; font-family:'Libre Franklin',sans-serif; font-size:17px; color:#16243f; background:#ffffff; border:none; border-radius:10px; padding:18px 22px; margin-bottom:16px;">
        <button type="button" style="width:100%; font-family:'Libre Franklin',sans-serif; font-size:19px; font-weight:700; color:#fdf6ea; background:#b41f2c; border:none; border-radius:10px; padding:19px 20px; cursor:pointer;">Sign Up</button>
        <p style="margin:22px 0 0; text-align:center; font-family:'Libre Franklin',sans-serif; font-size:15px; line-height:1.5; color:#8391a8;">We respect your privacy. Read our <a href="#" style="color:#c8cedd; text-decoration:underline;">Privacy Policy</a>.</p>
      </div>
    </div>

    <!-- WHILE YOU'RE HERE -->
    <div style="margin-top:64px; padding-top:44px; border-top:1px solid rgba(43,42,36,0.16);">
      <p style="margin:0 0 26px; font-family:'Libre Franklin',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#8a8172;">While you're here — Recent Posts</p>
      <div class="grid-3" style="display:grid; grid-template-columns:repeat(3,1fr); gap:28px;">
        {recentPosts.map((post) => (
          <a href={postUrl(post.slug)} style="display:block; background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; overflow:hidden;">
            <img src={imgUrl(post.image)} alt="" style="display:block; width:100%; height:170px; object-fit:cover; object-position:center 30%;">
            <div style="padding:20px 24px 26px;">
              <p style="margin:0 0 8px; font-family:'Libre Franklin',sans-serif; font-size:12px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#b41f2c;">{shortCat[post.category] || post.category}</p>
              <h3 style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:22px; line-height:1.22; color:#16243f;">{post.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Base>
