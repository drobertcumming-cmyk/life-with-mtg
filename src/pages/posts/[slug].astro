---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { posts } from '../../data/blog.js';
import { postUrl, categoryUrl, imgUrl, withBase, kickerOf } from '../../data/site.js';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = posts.find((p) => p.slug === slug);

const parasIntro = post.paragraphs.slice(0, 2);
const parasRest = post.paragraphs.slice(2);

// Related: same-category first, then fill from the rest; three total.
const related = posts
  .filter((p) => p.slug !== post.slug && p.category === post.category)
  .concat(posts.filter((p) => p.slug !== post.slug && p.category !== post.category))
  .slice(0, 3);

const kicker = post.subcategory ? `${post.category} · ${post.subcategory}` : post.category;
const shortTitle = post.title.length > 48 ? post.title.slice(0, 45).replace(/\s+\S*$/, '') + '…' : post.title;
const avatar = withBase('/assets/mtg-portrait.png');
---
<Base title={`${post.title} — Life with MTG`} description={post.snippet}>
  <Header />

  <!-- ============ ARTICLE ============ -->
  <div class="pad-x" style="max-width:1200px; margin:0 auto; padding:36px 40px 24px; position:relative;">

    <!-- breadcrumb -->
    <p style="margin:0 0 26px; font-family:'Libre Franklin',sans-serif; font-size:15px; color:#8a8172;">
      <a href={withBase('/')} style="color:#b41f2c; font-weight:600;">Home</a>
      <span style="margin:0 8px; color:#b0a894;">›</span>
      <a href={categoryUrl(post.catSlug)} style="color:#b41f2c; font-weight:600;">{post.category}</a>
      <span style="margin:0 8px; color:#b0a894;">›</span>
      <span style="color:#8a8172;">{shortTitle}</span>
    </p>

    <!-- sticky share rail -->
    <div class="share-rail" style="position:sticky; top:40px; float:left; width:60px; display:flex; flex-direction:column; align-items:center; gap:16px; margin-left:-8px;">
      <span style="font-family:'Libre Franklin',sans-serif; font-size:12px; font-weight:700; letter-spacing:0.22em; color:#8a8172; writing-mode:vertical-rl; transform:rotate(180deg); margin-bottom:6px;">SHARE</span>
      <a href="#" style="width:44px; height:44px; border-radius:50%; background:#faf5ea; border:1px solid rgba(43,42,36,0.15); display:flex; align-items:center; justify-content:center;"><svg width="17" height="17" viewBox="0 0 24 24" fill="#16243f"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-6.9l-5.4-7-6.2 7H1.7l8.1-9.3L1 2h7.1l4.9 6.4L18.9 2Zm-2.4 18h1.9L7.6 4H5.6l10.9 16Z"/></svg></a>
      <a href="#" style="width:44px; height:44px; border-radius:50%; background:#faf5ea; border:1px solid rgba(43,42,36,0.15); display:flex; align-items:center; justify-content:center;"><svg width="17" height="17" viewBox="0 0 24 24" fill="#16243f"><path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1C18.1 3 17.2 3 16.2 3c-2.3 0-3.9 1.4-3.9 4v2.6H9.5v3.2h2.8V21h1.2Z"/></svg></a>
      <a href="#" style="width:44px; height:44px; border-radius:50%; background:#faf5ea; border:1px solid rgba(43,42,36,0.15); display:flex; align-items:center; justify-content:center;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16243f" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></a>
    </div>

    <!-- article column -->
    <article style="max-width:760px; margin:0 auto;">
      <p style="margin:0 0 16px; font-family:'Libre Franklin',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#b41f2c;">{kicker}</p>
      <h1 class="display" style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:56px; line-height:1.06; color:#16243f; letter-spacing:-0.015em;">{post.title}</h1>

      <!-- byline -->
      <div style="display:flex; align-items:center; gap:16px; margin-top:30px;">
        <img src={avatar} alt="Marjorie Taylor Greene" style="display:block; width:52px; height:52px; border-radius:50%; object-fit:cover; object-position:center 20%; flex:none;">
        <div>
          <p style="margin:0; font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:700; color:#16243f;">By Marjorie Taylor Greene</p>
          <p style="margin:3px 0 0; font-family:'Libre Franklin',sans-serif; font-size:15px; color:#8a8172;">{post.date} · {post.readTime}</p>
        </div>
      </div>

      <!-- feature image -->
      <figure style="margin:34px 0 0;">
        <img src={imgUrl(post.image)} alt={post.title} style="display:block; width:100%; height:480px; object-fit:cover; object-position:center 30%; border-radius:14px;">
      </figure>

      <!-- body -->
      <div style="margin-top:40px;">
        {parasIntro.map((para) => (
          <p style="margin:0 0 26px; font-family:'Libre Franklin',sans-serif; font-size:20px; line-height:1.72; color:#33322b;">{para}</p>
        ))}

        {post.pullQuote && (
          <blockquote style="margin:38px 0; padding:6px 0 6px 30px; border-left:5px solid #b41f2c;">
            <p style="margin:0; font-family:'Newsreader',serif; font-style:italic; font-weight:500; font-size:30px; line-height:1.36; color:#16243f;">{post.pullQuote}</p>
          </blockquote>
        )}

        {parasRest.map((para) => (
          <p style="margin:0 0 26px; font-family:'Libre Franklin',sans-serif; font-size:20px; line-height:1.72; color:#33322b;">{para}</p>
        ))}
      </div>

      <!-- share this post -->
      <div style="display:flex; align-items:center; gap:12px; margin-top:44px; padding-top:30px; border-top:1px solid rgba(43,42,36,0.14);">
        <span style="font-family:'Libre Franklin',sans-serif; font-size:16px; font-weight:600; color:#514c40; margin-right:4px;">Share this post:</span>
        <a href="#" style="width:44px; height:44px; border-radius:50%; background:#faf5ea; border:1px solid rgba(43,42,36,0.15); display:flex; align-items:center; justify-content:center;"><svg width="16" height="16" viewBox="0 0 24 24" fill="#16243f"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-6.9l-5.4-7-6.2 7H1.7l8.1-9.3L1 2h7.1l4.9 6.4L18.9 2Zm-2.4 18h1.9L7.6 4H5.6l10.9 16Z"/></svg></a>
        <a href="#" style="width:44px; height:44px; border-radius:50%; background:#faf5ea; border:1px solid rgba(43,42,36,0.15); display:flex; align-items:center; justify-content:center;"><svg width="16" height="16" viewBox="0 0 24 24" fill="#16243f"><path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1C18.1 3 17.2 3 16.2 3c-2.3 0-3.9 1.4-3.9 4v2.6H9.5v3.2h2.8V21h1.2Z"/></svg></a>
        <a href="#" style="width:44px; height:44px; border-radius:50%; background:#faf5ea; border:1px solid rgba(43,42,36,0.15); display:flex; align-items:center; justify-content:center;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#16243f" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></a>
      </div>

      <!-- author bio -->
      <div style="display:flex; align-items:center; gap:22px; margin-top:38px; padding:28px 30px; background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px;">
        <img src={avatar} alt="Marjorie Taylor Greene" style="display:block; width:74px; height:74px; border-radius:50%; object-fit:cover; object-position:center 20%; flex:none;">
        <div>
          <p style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:23px; color:#16243f;">Marjorie Taylor Greene</p>
          <p style="margin:6px 0 0; font-family:'Libre Franklin',sans-serif; font-size:16px; color:#514c40;">Marjorie Taylor Greene represented Georgia's 14th District in Congress. She writes here in her own words — plainly, and with no one left to muzzle her.</p>
        </div>
      </div>
    </article>
  </div>

  <!-- ============ RELATED POSTS ============ -->
  <section class="pad-x" style="max-width:1200px; margin:0 auto; padding:44px 40px 20px;">
    <div style="display:flex; align-items:center; gap:20px; margin-bottom:26px;">
      <h2 style="margin:0; font-family:'Libre Franklin',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#8a8172;">Related Posts</h2>
      <span style="flex:1; height:1px; background:rgba(43,42,36,0.16);"></span>
    </div>
    <div class="grid-3" style="display:grid; grid-template-columns:repeat(3,1fr); gap:28px;">
      {related.map((rel) => (
        <a href={postUrl(rel.slug)} style="display:block; background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; overflow:hidden;">
          <img src={imgUrl(rel.image)} alt="" style="display:block; width:100%; height:150px; object-fit:cover; object-position:center 30%;">
          <div style="padding:18px 22px 24px;">
            <p style="margin:0 0 8px; font-family:'Libre Franklin',sans-serif; font-size:12px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#b41f2c;">{rel.category}</p>
            <h3 style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:21px; line-height:1.24; color:#16243f;">{rel.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  <Footer marginTop="40px" />
</Base>
