---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../data/site.js';

// Recent-media items are placeholders pending verified outlets/links from her team.
const media = [
  { tag: 'TV', title: '[Outlet] — segment title placeholder', meta: 'Jun 2026', action: 'Watch →' },
  { tag: 'Podcast', title: '[Show] — episode title placeholder', meta: 'Jun 2026', action: 'Listen →' },
  { tag: 'Press', title: '[Publication] — headline placeholder', meta: 'May 2026', action: 'Read →' },
  { tag: 'TV', title: '[Outlet] — segment title placeholder', meta: 'May 2026', action: 'Watch →' },
];

const imgIcon = `<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#b0a894" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>`;
---
<Base title="Media & Press — Life with MTG">
  <Header active="media" />

  <!-- ============ HERO ============ -->
  <section class="hero-split" style="display:grid; grid-template-columns:1fr 1fr; align-items:stretch;">
    <div style="background:#16243f; display:flex; align-items:stretch; overflow:hidden;">
      <img src={withBase('/assets/mtg-media-headshot.jpg')} alt="Marjorie Taylor Greene" style="display:block; width:100%; height:100%; min-height:540px; align-self:stretch; object-fit:cover; object-position:center 25%; border:none; outline:none;">
    </div>
    <div style="background:#faf5ea; display:flex; justify-content:flex-start;">
      <div style="width:100%; max-width:560px; padding:64px 40px; display:flex; flex-direction:column; justify-content:center;">
        <p style="margin:0 0 14px; font-family:'Libre Franklin',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.22em; text-transform:uppercase; color:#b41f2c;">Media &amp; Press</p>
        <h1 class="display" style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:54px; line-height:1.05; color:#16243f; letter-spacing:-0.015em;">Media and Press Resources</h1>
        <p style="margin:22px 0 0; font-size:20px; line-height:1.55; color:#514c40; max-width:480px;">Brand and mission overview — a few sentences on who MTG is and what Life with MTG stands for. <span style="font-style:italic; color:#8a8172;">[Her copy, her sign-off.]</span></p>
        <div style="display:flex; align-items:center; gap:16px; margin-top:32px; flex-wrap:wrap;">
          <a href="#press" style="font-family:'Libre Franklin',sans-serif; font-size:17px; font-weight:700; color:#fdf6ea; background:#b41f2c; padding:15px 30px; border-radius:9px;">Press inquiries</a>
          <a href="#" style="display:flex; align-items:center; gap:10px; font-family:'Libre Franklin',sans-serif; font-size:17px; font-weight:600; color:#16243f; background:transparent; padding:14px 26px; border-radius:9px; border:1.5px solid #16243f;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#16243f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="m7 11 5 5 5-5"></path><path d="M5 21h14"></path></svg>
            Download press kit
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MAIN ============ -->
  <main class="pad-x" style="max-width:1200px; margin:0 auto; padding:64px 40px 20px;">

    <!-- KEY FACTS -->
    <div style="display:flex; align-items:center; gap:20px; margin-bottom:22px;">
      <h2 style="margin:0; font-family:'Libre Franklin',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#8a8172;">Key Facts</h2>
      <span style="flex:1; height:1px; background:rgba(43,42,36,0.16);"></span>
    </div>
    <div class="grid-4" style="display:grid; grid-template-columns:repeat(4,1fr); gap:24px;">
      <div style="background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; padding:28px 26px;">
        <p style="margin:0; font-family:'Newsreader',serif; font-weight:700; font-size:30px; color:#16243f;">2021–2026</p>
        <p style="margin:12px 0 0; font-family:'Libre Franklin',sans-serif; font-size:16px; line-height:1.5; color:#514c40;">Former U.S. Representative, Georgia's 14th District</p>
      </div>
      <div style="background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; padding:28px 26px;">
        <p style="margin:0; font-family:'Newsreader',serif; font-weight:700; font-size:30px; color:#16243f;">Founder</p>
        <p style="margin:12px 0 0; font-family:'Libre Franklin',sans-serif; font-size:16px; line-height:1.5; color:#514c40;">Life with MTG · independent media &amp; commentary</p>
      </div>
      <div style="background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; padding:28px 26px;">
        <p style="margin:0; font-family:'Newsreader',serif; font-weight:700; font-size:30px; color:#16243f;">Entrepreneur</p>
        <p style="margin:12px 0 0; font-family:'Libre Franklin',sans-serif; font-size:16px; line-height:1.5; color:#514c40;">B.B.A., University of Georgia · business owner</p>
      </div>
      <div style="background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; padding:28px 26px;">
        <p style="margin:0; font-family:'Newsreader',serif; font-weight:700; font-size:30px; color:#16243f;">[00]M+</p>
        <p style="margin:12px 0 0; font-family:'Libre Franklin',sans-serif; font-size:16px; line-height:1.5; color:#514c40;">Combined social following · <span style="font-style:italic; color:#8a8172;">verify</span></p>
      </div>
    </div>

    <!-- RECENT MEDIA -->
    <div style="display:flex; align-items:center; gap:20px; margin:52px 0 24px;">
      <h2 style="margin:0; font-family:'Libre Franklin',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#8a8172;">Recent Media — TV &amp; Press</h2>
      <span style="flex:1; height:1px; background:rgba(43,42,36,0.16);"></span>
    </div>
    <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:26px;">
      {media.map((m) => (
        <a href="#"><article style="display:grid; grid-template-columns:150px 1fr; gap:0; align-items:stretch; background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:14px; overflow:hidden;">
          <div style="width:150px; min-height:150px; align-self:stretch; background:#ece2cd; display:flex; align-items:center; justify-content:center;" set:html={imgIcon}></div>
          <div style="padding:26px 28px;">
            <p style="margin:0 0 8px; font-family:'Libre Franklin',sans-serif; font-size:12px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#b41f2c;">{m.tag}</p>
            <h3 style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:23px; line-height:1.2; color:#16243f;">{m.title}</h3>
            <p style="margin:14px 0 0; font-family:'Libre Franklin',sans-serif; font-size:15px; color:#8a8172;">{m.meta} · <span style="color:#b41f2c; font-weight:700;">{m.action}</span></p>
          </div>
        </article></a>
      ))}
    </div>
    <p style="margin:22px 0 0; font-family:'Libre Franklin',sans-serif; font-size:15px; font-style:italic; color:#8a8172;">Placeholders — her team supplies verified outlets, titles, dates, and links. No appearance is asserted as fact here.</p>

    <!-- PRESS + FOLLOW -->
    <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:28px; margin-top:44px;">
      <div id="press" style="background:#16243f; border-radius:16px; padding:40px 42px; display:flex; flex-direction:column; justify-content:center;">
        <h3 style="margin:0; font-family:'Newsreader',serif; font-weight:600; font-size:32px; color:#f6efdf;">Press &amp; booking inquiries</h3>
        <p style="margin:14px 0 0; font-family:'Libre Franklin',sans-serif; font-size:17px; line-height:1.55; color:#b6bfd1;">For interviews, bookings, and media requests, contact the press team directly.</p>
        <a href="mailto:press@lifewithmtg.com" style="display:flex; align-items:center; gap:12px; margin-top:26px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.16); border-radius:10px; padding:16px 20px;">
          <span style="width:18px; height:18px; border:2px solid #c19a3e; border-radius:4px; flex:none;"></span>
          <span style="font-family:'Libre Franklin',sans-serif; font-size:17px; font-weight:700; color:#f6efdf;">press@lifewithmtg.com</span>
          <span style="font-family:'Libre Franklin',sans-serif; font-size:15px; font-style:italic; color:#8391a8;">· placeholder</span>
        </a>
      </div>

      <div style="background:#faf5ea; border:1px solid rgba(43,42,36,0.13); border-radius:16px; padding:40px 42px; display:flex; flex-direction:column; justify-content:center;">
        <h3 style="margin:0 0 22px; font-family:'Libre Franklin',sans-serif; font-size:13px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#8a8172;">Follow MTG</h3>
        <div style="display:flex; gap:16px; flex-wrap:wrap;">
          <a href="#" aria-label="X" style="width:56px; height:56px; border-radius:50%; background:#16243f; display:flex; align-items:center; justify-content:center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="#f6efdf"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-6.9l-5.4-7-6.2 7H1.7l8.1-9.3L1 2h7.1l4.9 6.4L18.9 2Zm-2.4 18h1.9L7.6 4H5.6l10.9 16Z"/></svg></a>
          <a href="#" aria-label="Facebook" style="width:56px; height:56px; border-radius:50%; background:#16243f; display:flex; align-items:center; justify-content:center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="#f6efdf"><path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1C18.1 3 17.2 3 16.2 3c-2.3 0-3.9 1.4-3.9 4v2.6H9.5v3.2h2.8V21h1.2Z"/></svg></a>
          <a href="#" aria-label="Instagram" style="width:56px; height:56px; border-radius:50%; background:#16243f; display:flex; align-items:center; justify-content:center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f6efdf" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1.2" fill="#f6efdf" stroke="none"></circle></svg></a>
          <a href="#" aria-label="YouTube" style="width:56px; height:56px; border-radius:50%; background:#16243f; display:flex; align-items:center; justify-content:center;"><svg width="24" height="24" viewBox="0 0 24 24" fill="#f6efdf"><path d="M22 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.8 1.8C5.7 19 12 19 12 19s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8C22 15.2 22 12 22 12Zm-12 3V9l5 3-5 3Z"/></svg></a>
          <a href="#" aria-label="Truth Social" style="width:56px; height:56px; border-radius:50%; background:#16243f; display:flex; align-items:center; justify-content:center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f6efdf" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v10a4 4 0 0 1-4 4H9l-5 4V4Z"></path></svg></a>
        </div>
        <p style="margin:22px 0 0; font-family:'Libre Franklin',sans-serif; font-size:15px; line-height:1.5; color:#8a8172;">X · Facebook · Instagram · YouTube · Truth Social · <span style="font-style:italic;">handles TBC</span></p>
      </div>
    </div>
  </main>

  <Footer marginTop="60px" />
</Base>
